<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teaching - Notes From Over There</title>
    <meta name="description" content="Teaching courses by Ismail Fayed">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="main-nav">
        <div class="nav-container">
            <a href="index.html" class="nav-logo">Notes From Over There</a>
            <button class="menu-toggle" aria-label="Toggle menu">&#9776;</button>
            <div class="nav-links">
                <a href="/index.html">Home</a>
                <a href="/english/index.html">English</a>
                <a href="/arabic/index.html">العربية</a>
                <a href="/blog/index.html" class="active">Blog</a>
                <a href="/about.html">About</a>
                <a href="/portfolio.pdf" target="_blank">portfolio</a>
                <a href="/contact.html">Contact</a>
                 <a href="https://instagram.com/notes_fromoverthere" target="_blank" class="https://www.instagram.com/notes_fromoverthere/">IG</a>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <header class="category-header">
        <div class="container">
            <h1>Teaching</h1>
            <p class="category-description">Selections of courses taught at the Cairo Institute for Liberal Arts and Sciences</p>
        </div>
    </header>

    <!-- Main Content -->
    <main class="category-content">
        <div class="container">
            <div class="reviews-grid">
                <!-- Course 1: Can we talk about love? -->
                <article class="review-card">
                    <div class="review-thumbnail">
                        <img src="../../../assets/thumbnails/teach-thumb-01.jpg" alt="Can we talk about love?" class="thumbnail-image">
                    </div>
                    <h2>Can we talk about love?</h2>
                    <p class="review-excerpt">A critical attempt to have a meaningful conversation about ‘love’ through philosophy, psychology, and literature.</p>
                    <a href="course-01.html" class="read-more-btn">Learn More</a>
                </article>

                <!-- Course 2: Reading the Self -->
                <article class="review-card">
                    <div class="review-thumbnail">
                        <img src="../../../assets/thumbnails/teach-thumb-02.jpg" alt="Reading the Self: Autobiography and the Making and Unmaking of the Modern Subject in Egypt" class="thumbnail-image">
                    </div>
                    <h2>Reading the Self: Autobiography and the Making and Unmaking of the Modern Subject in Egypt</h2>
                    <p class="review-excerpt">Exploring autobiographies of al-Nahda figures as acts of self-making and their relevance today.</p>
                    <a href="course-02.html" class="read-more-btn">Learn More</a>
                </article>

                <!-- Course 3: On Violence -->
                <article class="review-card">
                    <div class="review-thumbnail">
                        <img src="../../../assets/thumbnails/teach-thumb-03.jpg" alt="On Violence" class="thumbnail-image">
                    </div>
                    <h2>On Violence</h2>
                    <p class="review-excerpt">A historical and contemporary overview of intellectual traditions defining and critiquing violence.</p>
                    <a href="course-03.html" class="read-more-btn">Learn More</a>
                </article>

                <!-- Course 4: Memory, Identity and History -->
                <article class="review-card">
                    <div class="review-thumbnail">
                        <img src="../../../assets/thumbnails/teach-thumb-04.jpg" alt="Memory, Identity and History" class="thumbnail-image">
                    </div>
                    <h2>Memory, Identity and History</h2>
                    <p class="review-excerpt">Examining cultural memory in post-WWII Egypt, critiquing Western discourses on grievance and history.</p>
                    <a href="course-04.html" class="read-more-btn">Learn More</a>
                </article>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <p>&copy; 2022 Ismail Fayed. All rights reserved.</p>
            <p><a href="../index.html">Notes From Over There</a></p>
        </div>
    </footer>

    <style>
        /* General styles from index-2.html */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Noto Sans', sans-serif;
            line-height: 1.6;
            color: #333;
            background: #FDE5D6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Navigation */
        .main-nav {
            background: rgba(253, 229, 214, 0.95);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            direction: ltr;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-logo {
            color: #333;
            text-decoration: none;
            font-size: 1.2rem;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: #333;
            text-decoration: none;
            transition: opacity 0.3s;
            font-size: 0.9rem;
        }

        .nav-links a:hover,
        .nav-links a.active {
            opacity: 0.7;
        }

        /* Header */
        .category-header {
            padding: 6rem 0 3rem 0;
            margin-top: 60px;
            text-align: center;
        }

        .category-header h1 {
            font-size: 2.5rem;
            color: #333;
            margin-bottom: 1rem;
        }

        .category-description {
            font-size: 1.2rem;
            color: #666;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Main Content */
        .category-content {
            padding: 4rem 0;
        }

        .reviews-grid { /* Reused for teaching cards */
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
        }

        .review-card { /* Reused for teaching cards */
            background: rgba(255, 255, 255, 0.3);
            border-left: 4px solid #FA8072;
            padding: 2rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .review-card:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.5);
        }

        .review-thumbnail {
            width: 97px;
            height: 97px;
            margin-bottom: 1rem;
            overflow: hidden;
            border-radius: 8px;
        }

        .thumbnail-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
        }

        .review-card h2 {
            font-size: 1.4rem;
            color: #333;
            margin-bottom: 1rem;
            line-height: 1.3;
            font-weight: 500;
        }

        .review-excerpt {
            color: #555;
            margin-bottom: 1.5rem;
            line-height: 1.7;
            font-size: 0.95rem;
        }

        .read-more-btn {
            background: #FA8072;
            color: white;
            padding: 0.56rem 1.04rem;
            text-decoration: none;
            border-radius: 5px;
            transition: background 0.3s ease;
            font-weight: 500;
            font-size: 0.8rem;
            display: inline-block;
        }

        .read-more-btn:hover {
            background: #E55B4D;
        }

        /* Footer */
        .main-footer {
            background: rgba(0, 0, 0, 0.1);
            color: #333;
            text-align: center;
            padding: 2rem 0;
        }

        .main-footer a {
            color: #333;
            text-decoration: none;
        }

        .main-footer a:hover {
            text-decoration: underline;
        }

        .menu-toggle {
          display: none;
          background: none;
          border: none;
          font-size: 1.5rem;
          cursor: pointer;
          color: #333;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .menu-toggle {
               display: block;
            }

            .nav-container {
                padding: 0 1rem;
                flex-direction: column;
                gap: 1rem;
            }

            .nav-links {
                display: none;
                flex-direction: column;
                gap: 1rem;
                justify-content: center;
                margin-top: 1rem;
            }

            .nav-links.active {
                display: flex;
            }

            .category-header {
                padding: 5rem 0 2rem 0;
                margin-top: 120px;
            }

            .category-header h1 {
                font-size: 2rem;
            }

            .reviews-grid {
                grid-template-columns: 1fr;
            }

            .container {
                padding: 0 1rem;
            }

            .review-card {
                padding: 1.5rem;
            }
        }

        @media (max-width: 480px) {
            .category-header h1 {
                font-size: 1.5rem;
            }

            .review-card {
                padding: 1rem;
            }

            .review-card h2 {
                font-size: 1.2rem;
            }

            .nav-links {
                flex-direction: column;
                text-align: center;
                gap: 0.5rem;
            }
        }
    </style>
    <script>
        const toggle = document.querySelector('.menu-toggle');
        const navLinks = document.querySelector('.nav-links');

        toggle.addEventListener('click', () => {
            navLinks.classList.toggle('active');
        });
    </script>
</body>
</html>

